# Copy to .env and adjust. Every key is optional; the values below are the defaults used by settings.py.

# --- Codex agent ---
# Command used to launch Codex (comma-separated parts, e.g. `python,fake_codex.py`; tests point this at a fake script).
CODEX_CMD=codex
# Model slug, as listed by `codex debug models`.
CODEX_MODEL=gpt-6-luna
# Reasoning effort: low | medium | high | xhigh | max (supported levels for gpt-6-luna).
CODEX_REASONING_EFFORT=medium
# Reasoning summary in the event stream so the log shows the agent's thinking: auto | concise | detailed | none.
CODEX_REASONING_SUMMARY=auto
# Web search mode: live | cached | indexed | disabled (https://learn.chatgpt.com/docs/config-file/config-basic.md).
CODEX_WEB_SEARCH=live
# Skip ~/.codex/config.toml (your MCP servers, hooks, profiles) for the news agents; login still works.
CODEX_IGNORE_USER_CONFIG=true
# Codex features turned off per agent (comma-separated): cuts plugin downloads at startup and sub-agent fan-out.
CODEX_DISABLE_FEATURES=plugins,remote_plugin,apps,plugin_sharing,tool_suggest,multi_agent

# --- Run limits ---
# How many topic agents run at the same time.
MAX_PARALLEL_AGENTS=6
# Kill an agent (and its child processes) after this many minutes.
AGENT_TIMEOUT_MINUTES=30
# Extra attempts when an agent fails or returns invalid JSON (not used for usage-limit/auth errors).
AGENT_MAX_RETRIES=1
# Items requested per selected interval x type x source x variant cell.
ITEMS_PER_CELL=2
# Hard cap on items one topic agent may return.
MAX_ITEMS_PER_AGENT=60

# --- Paths (relative to the project root) ---
RUNS_DIR=runs
LOGS_DIR=logs
DATA_DIR=data
